{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wfos/ontarch/schemas/runtime-command-record.schema.json",
  "title": "Takogami command execution record",
  "description": "Operational command execution records written under the resolved Takogami state home (default XDG state). Distinct from tracked Ontarch build-session provenance under logs.session_log_target / registry/sessions/, and from composed work-session manifests. Secret values, full inherited environment dumps, provider socket paths, and pane scrollback are forbidden. schema_version 0.1.0 is the first persisted MVP baseline.",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "session_id",
    "plan_digest",
    "started_at",
    "actor",
    "profile_id",
    "request",
    "policy_decision",
    "execution",
    "source_fingerprints",
    "output_summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "Mismatched schema_version is a typed contract error; never silently coerced."
    },
    "record_kind": {
      "type": "string",
      "const": "command_execution",
      "description": "Labels this record as a command execution audit record, not a composed work session."
    },
    "session_id": { "type": "string", "minLength": 1 },
    "plan_digest": {
      "type": "string",
      "minLength": 1,
      "description": "Sealed plan digest correlating this record with the authorized/rejected plan."
    },
    "parent_session_id": { "type": "string" },
    "work_session_id": {
      "type": "string",
      "minLength": 1,
      "description": "Optional link to a composed work-session manifest. Opaque ID only."
    },
    "runtime_context": {
      "type": "object",
      "required": ["provider"],
      "additionalProperties": false,
      "description": "Optional provider-neutral terminal runtime link. Opaque IDs only — never socket paths or scrollback.",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "Terminal runtime provider (e.g. herdr, tmux, direct)."
        },
        "workspace_id": { "type": "string" },
        "tab_id": { "type": "string" },
        "pane_id": { "type": "string" }
      }
    },
    "started_at": { "type": "string", "minLength": 1 },
    "ended_at": { "type": "string" },
    "actor": { "type": "string", "const": "agent" },
    "profile_id": { "type": "string", "minLength": 1 },
    "request": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string" },
        "unit_id": { "type": "string" },
        "verb": { "type": "string" },
        "flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resolution": { "$ref": "#/definitions/resolved_command" },
    "policy_decision": { "$ref": "#/definitions/policy_decision" },
    "execution": {
      "type": "object",
      "required": ["started", "outcome"],
      "additionalProperties": false,
      "properties": {
        "started": { "type": "boolean" },
        "pid": { "type": "integer", "minimum": 0 },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "signal": { "type": "string" },
        "outcome": {
          "type": "string",
          "enum": [
            "pending",
            "planned",
            "denied",
            "gated",
            "execution_unavailable",
            "failed_to_spawn",
            "completed",
            "interrupted",
            "controller_error",
            "abandoned"
          ]
        }
      }
    },
    "source_fingerprints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "algorithm", "digest"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "algorithm": { "type": "string", "const": "sha256" },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "output_summary": {
      "type": "object",
      "required": ["stdout_bytes", "stderr_bytes", "truncated", "encoding", "compressor"],
      "additionalProperties": false,
      "properties": {
        "stdout_bytes": { "type": "integer", "minimum": 0 },
        "stderr_bytes": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "encoding": { "type": "string", "enum": ["utf-8", "lossy-utf-8", "binary"] },
        "compressor": {
          "type": "string",
          "enum": ["none", "rtk", "disabled", "unsupported", "unavailable", "failed"]
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string", "maxLength": 4096 }
      }
    }
  },
  "definitions": {
    "resolved_command": {
      "type": "object",
      "required": [
        "schema_version",
        "session_id",
        "unit_id",
        "verb",
        "descriptor_path",
        "descriptor_fingerprint",
        "native_manifests",
        "backend",
        "adapter",
        "program",
        "argv",
        "cwd",
        "env_keys",
        "profile_id",
        "policy_ids",
        "registry_generation",
        "execution_class"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "const": "0.1.0" },
        "session_id": { "type": "string" },
        "unit_id": { "type": "string" },
        "verb": { "type": "string" },
        "descriptor_path": { "type": "string" },
        "descriptor_fingerprint": { "type": "string" },
        "native_manifests": { "type": "array", "items": { "type": "string" } },
        "backend": { "type": "string" },
        "adapter": { "type": "string" },
        "program": { "type": "string" },
        "argv": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "env_keys": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Environment key names only — never values."
        },
        "profile_id": { "type": "string" },
        "policy_ids": { "type": "array", "items": { "type": "string" } },
        "registry_generation": {
          "type": "object",
          "required": ["generated_at", "source_fingerprints"],
          "additionalProperties": false,
          "properties": {
            "generated_at": { "type": "string" },
            "source_fingerprints": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "algorithm", "digest"],
                "additionalProperties": false,
                "properties": {
                  "path": { "type": "string" },
                  "algorithm": { "type": "string", "const": "sha256" },
                  "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              }
            }
          }
        },
        "execution_class": {
          "type": "string",
          "enum": ["direct", "interactive_session"]
        },
        "runtime_provider": {
          "type": ["string", "null"],
          "description": "Optional provider id; null/absent for direct execution."
        }
      }
    },
    "policy_decision": {
      "oneOf": [
        {
          "type": "object",
          "required": ["outcome", "matched_rules"],
          "additionalProperties": false,
          "properties": {
            "outcome": { "const": "allow" },
            "matched_rules": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "required": ["outcome", "policy_id", "rule_id", "reason", "required_approval"],
          "additionalProperties": false,
          "properties": {
            "outcome": { "const": "gate" },
            "policy_id": { "type": "string" },
            "rule_id": { "type": "string" },
            "reason": { "type": "string" },
            "required_approval": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["outcome", "policy_id", "rule_id", "reason"],
          "additionalProperties": false,
          "properties": {
            "outcome": { "const": "deny" },
            "policy_id": { "type": "string" },
            "rule_id": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      ]
    }
  }
}
