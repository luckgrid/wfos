{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wfos/ontarch/schemas/bin-cleanup-plan.schema.json",
  "title": "Ontarch bin cleanup plan",
  "description": "Non-mutating machine cleanup plan from ontarch bin-cleanup report-only/dry-run. mutation_executed is always false.",
  "type": "object",
  "required": [
    "generated_at",
    "mode",
    "scope",
    "inventory_generated_at",
    "inventory_refreshed",
    "summary",
    "entries",
    "mutation_executed"
  ],
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "mode": {
      "type": "string",
      "enum": ["report-only", "dry-run", "archive", "delete-approved"]
    },
    "scope": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+/bin(/[A-Za-z0-9._-]+)+$"
        }
      ]
    },
    "inventory_generated_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "inventory_refreshed": { "type": "boolean" },
    "summary": {
      "type": "object",
      "required": ["total", "advisory", "would_archive", "would_delete", "blocked"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "advisory": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "would_archive": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "would_delete": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "blocked": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "disposition", "reason", "retention", "approved_to_matches"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+/bin(/[A-Za-z0-9._-]+)+$"
          },
          "disposition": {
            "type": "string",
            "enum": ["advisory", "would_archive", "would_delete", "blocked"]
          },
          "reason": {
            "type": "string",
            "enum": [
              "approved",
              "approved-to-mismatch",
              "approved-to-null",
              "current",
              "invalid-manifest",
              "lib-or-src",
              "multiple-manifests",
              "no-manifest",
              "outside-scope",
              "retention-permanent",
              "retention-review-required",
              "scope-required",
              "stale"
            ]
          },
          "retention": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "string",
                "pattern": "^(review-before-delete|permanent|session-exports|auto-archive-after:[0-9]+d)$"
              }
            ]
          },
          "approved_to_matches": { "type": ["boolean", "null"] }
        }
      }
    },
    "mutation_executed": { "type": "boolean", "const": false }
  }
}
