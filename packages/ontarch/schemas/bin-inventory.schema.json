{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wfos/ontarch/schemas/bin-inventory.schema.json",
  "title": "Ontarch bin inventory",
  "description": "Read-only machine inventory of Workstreams/*/bin/<workflow>/ directories. Generated by ontarch bin-report.",
  "type": "object",
  "required": ["generated_at", "root", "summary", "workflows"],
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "root": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "required": ["total", "with_manifest"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "with_manifest": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size_bytes",
          "file_count",
          "oldest_file_age_days",
          "newest_file_age_days",
          "manifest_present",
          "manifest_count"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+/bin(/[A-Za-z0-9._-]+)+$"
          },
          "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1099511627776 },
          "file_count": { "type": "integer", "minimum": 0, "maximum": 10000000 },
          "oldest_file_age_days": { "type": ["integer", "null"], "minimum": 0, "maximum": 365000 },
          "newest_file_age_days": { "type": ["integer", "null"], "minimum": 0, "maximum": 365000 },
          "manifest_present": { "type": "boolean" },
          "manifest_count": { "type": "integer", "minimum": 0, "maximum": 100000 }
        }
      }
    }
  }
}
