{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wfos/ontarch/graphs/edges.schema.json",
  "title": "Ontarch project graph",
  "description": "The generated relationship graph: nodes (units, capabilities, policies, actors) and directed edges between them. Canon: metadata-plane graphs. Generated by `ontarch sync` into registry/graph.json (host-specific, gitignored).",
  "type": "object",
  "required": ["generated_at", "registry_generation", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "generated_at": { "type": "string", "minLength": 1 },
    "registry_generation": {
      "type": "object",
      "required": ["generated_at", "source_fingerprints"],
      "additionalProperties": false,
      "properties": {
        "generated_at": { "type": "string", "minLength": 1 },
        "source_fingerprints": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["path", "algorithm", "digest"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^registry/[a-z0-9][a-z0-9._-]*\\.json$"
              },
              "algorithm": { "type": "string", "const": "sha256" },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": [
              "workspace",
              "native-toolchain",
              "metadata-plane",
              "runtime-controller",
              "package-translator",
              "portable-component-runtime",
              "package",
              "app",
              "site",
              "pattern",
              "tool",
              "runtime",
              "agent",
              "policy",
              "capability",
              "actor",
              "profile",
              "skill"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "rel", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "rel": {
            "type": "string",
            "enum": [
              "provides",
              "requires",
              "uses",
              "governed-by",
              "blocked-by",
              "packaged-by",
              "runs-on",
              "selects",
              "can-invoke"
            ]
          },
          "to": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
