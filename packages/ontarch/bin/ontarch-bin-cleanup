#!/usr/bin/env bash
# ontarch-bin-cleanup — draft-safe bin cleanup planner.
# Modes: report-only (default), dry-run, archive, delete-approved.
# --json: typed cleanup-plan document on stdout for report-only/dry-run;
# archive/delete refuse with stderr JSON diagnostic + nonzero (no stdout success).
# At gateway_state: draft, archive/delete-approved validate arguments then refuse —
# they never call rm or mv. Agents under PANOPLY_AGENT=1 are refused those modes outright.
# See docs/bin-archive.md.
set -uo pipefail

_self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$_self/../lib/common.sh"
# shellcheck source=../lib/registry.sh
source "$_self/../lib/registry.sh"

ontarch_require_jq

MODE=""
SCOPE=""
JSON_MODE=0
SEEN_MODE=0
SEEN_SCOPE=0

usage() {
  cat <<EOF
ontarch bin-cleanup — draft-safe cleanup planner (no silent deletes)

usage: ontarch bin-cleanup [--mode report-only|dry-run|archive|delete-approved] [--scope <path>] [--json]

modes:
  report-only       print inventory summary + stale candidates (default; no action)
  dry-run           print an exact move/delete plan; exit 0; no action
  archive           validate then refuse at draft gateway (human-only; deferred)
  delete-approved   require --scope; validate then refuse at draft gateway (human-only; deferred)

Blocked always: rm -rf globs, git clean, lib/src deletes, retention=permanent,
unmanifested deletes, scope mismatch / path traversal, multiple manifests.

--json emits one cleanup-plan JSON document (report-only/dry-run). Archive/delete
refusal uses stderr JSON + nonzero exit (no mixed stdout success).
EOF
}

_emit_refusal_json() {
  local mode="$1" reason="$2"
  jq -nc --arg mode "$mode" --arg reason "$reason" --arg ts "$(_ontarch_now)" \
    '{error:"deferred_unavailable",mode:$mode,reason:$reason,generated_at:$ts,mutation_executed:false}' >&2
}

# Locked option policy:
# - --mode VALUE and --mode=VALUE accepted
# - --scope VALUE and --scope=VALUE accepted
# - duplicate --mode / --scope → error
# - missing values → error
# - --json before/after other options accepted; duplicate --json idempotent
# - default mode report-only when --mode omitted
while [ $# -gt 0 ]; do
  case "$1" in
    --json) JSON_MODE=1; shift ;;
    --mode)
      [ "$SEEN_MODE" -eq 0 ] || { ontarch_err "duplicate --mode"; usage; exit 1; }
      SEEN_MODE=1
      MODE="${2:-}"
      [ -n "$MODE" ] || { ontarch_err "missing --mode value"; usage; exit 1; }
      shift 2
      ;;
    --mode=*)
      [ "$SEEN_MODE" -eq 0 ] || { ontarch_err "duplicate --mode"; usage; exit 1; }
      SEEN_MODE=1
      MODE="${1#--mode=}"
      [ -n "$MODE" ] || { ontarch_err "missing --mode value"; usage; exit 1; }
      shift
      ;;
    --scope)
      [ "$SEEN_SCOPE" -eq 0 ] || { ontarch_err "duplicate --scope"; usage; exit 1; }
      SEEN_SCOPE=1
      SCOPE="${2:-}"
      [ -n "$SCOPE" ] || { ontarch_err "missing --scope value"; usage; exit 1; }
      shift 2
      ;;
    --scope=*)
      [ "$SEEN_SCOPE" -eq 0 ] || { ontarch_err "duplicate --scope"; usage; exit 1; }
      SEEN_SCOPE=1
      SCOPE="${1#--scope=}"
      [ -n "$SCOPE" ] || { ontarch_err "missing --scope value"; usage; exit 1; }
      shift
      ;;
    -h|--help) usage; exit 0 ;;
    *) ontarch_err "unknown argument: $1"; usage; exit 1 ;;
  esac
done

[ -n "$MODE" ] || MODE="report-only"

case "$MODE" in
  report-only|dry-run|archive|delete-approved) ;;
  *) ontarch_err "unknown mode: $MODE"; usage; exit 1 ;;
esac

if [ "$JSON_MODE" -eq 1 ]; then
  ontarch_info() { printf '%s\n' "${_C_BLUE}::${_C_RESET} $*" >&2; }
  ontarch_ok()   { printf '%s\n' "${_C_GREEN}ok${_C_RESET} $*" >&2; }
fi

# Normalize and reject path traversal / absolute escapes outside WS_ROOT.
_normalize_scope() {
  local s="$1"
  [ -n "$s" ] || return 1
  case "$s" in
    *..*|~*|/*|*\\*|*[$'\n\r\t']*) return 1 ;;
  esac
  case "$s" in
    */bin|*/bin/*|bin/*) ;;
    *) return 1 ;;
  esac
  # lib/src never valid as cleanup scope
  case "$s" in
    */lib|*/lib/*|*/src|*/src/*|lib/*|src/*) return 1 ;;
  esac
  # Must match inventory path grammar: <ns>/bin/<seg>(/<seg>)*
  case "$s" in
    */bin/*) ;;
    *) return 1 ;;
  esac
  printf '%s\n' "$s"
}

# Validate mode/scope BEFORE any inventory locate/refresh (fail closed; no registry writes).
if [ -n "$SCOPE" ]; then
  if ! SCOPE="$(_normalize_scope "$SCOPE")"; then
    if [ "$JSON_MODE" -eq 1 ]; then
      _emit_refusal_json "$MODE" "invalid_scope"
    else
      ontarch_err "invalid --scope (must be a relative namespace bin path; no .. or absolute)"
    fi
    exit 1
  fi
fi
if [ "$MODE" = "delete-approved" ] && [ -z "$SCOPE" ]; then
  if [ "$JSON_MODE" -eq 1 ]; then
    _emit_refusal_json "$MODE" "scope_required"
  else
    ontarch_err "mode=delete-approved requires --scope <path>"
  fi
  exit 1
fi

INV="$ONTARCH_REGISTRY/bin-inventory.json"
INVENTORY_REFRESHED=false

# Locate/validate/refresh inventory only after mode+scope preflight.
if [ -f "$INV" ]; then
  if ! ontarch_validate_bin_inventory_doc "$INV" "$WS_ROOT"; then
    ontarch_err "existing bin-inventory.json is invalid — refuse planning (no overwrite)"
    exit 1
  fi
else
  ontarch_warn "bin-inventory.json absent — generating via bin-report"
  if [ "$JSON_MODE" -eq 1 ]; then
    "$_self/ontarch-bin-report" >&2 || ontarch_die "bin-report failed"
  else
    "$_self/ontarch-bin-report" || ontarch_die "bin-report failed"
  fi
  INVENTORY_REFRESHED=true
  [ -f "$INV" ] || ontarch_die "bin-inventory.json missing after refresh"
  if ! ontarch_validate_bin_inventory_doc "$INV" "$WS_ROOT"; then
    ontarch_err "refreshed bin-inventory.json failed validation"
    exit 1
  fi
fi

_is_blocked_path() {
  local p="$1"
  case "$p" in
    */lib|*/lib/*|*/src|*/src/*|lib/*|src/*) return 0 ;;
  esac
  return 1
}

# Locate the single authoritative manifest under a workflow when inventory says count==1.
# Args: <rel path>
_find_single_manifest() {
  local rel="$1"
  local abs="$WS_ROOT/$rel"
  local hits
  if command -v fd >/dev/null 2>&1; then
    hits="$(fd --type f --hidden --no-ignore '^manifest\.json$' "$abs" 2>/dev/null || true)"
  else
    hits="$(find "$abs" -type f -name 'manifest.json' 2>/dev/null || true)"
  fi
  [ -n "$hits" ] || return 1
  local n
  n="$(printf '%s\n' "$hits" | sed '/^$/d' | wc -l | tr -d ' ')"
  [ "$n" = "1" ] || return 1
  printf '%s\n' "$hits" | sed '/^$/d' | head -1
}

_print_inventory_summary() {
  printf 'mode: %s\n' "$MODE"
  printf 'inventory: %s\n' "$INV"
  printf 'generated_at: %s\n' "$(jq -r '.generated_at' "$INV")"
  printf 'workflows: %s (with_manifest: %s)\n\n' \
    "$(jq -r '.summary.total' "$INV")" \
    "$(jq -r '.summary.with_manifest' "$INV")"
}

# Parse auto-archive-after:<N>d → N days, or empty if not that form.
_auto_archive_days() {
  local retention="$1"
  case "$retention" in
    auto-archive-after:*d)
      local n="${retention#auto-archive-after:}"
      n="${n%d}"
      case "$n" in
        ''|*[!0-9]*) printf '' ;;
        *) printf '%s\n' "$n" ;;
      esac
      ;;
    *) printf '' ;;
  esac
}

# Classify one workflow path into a cleanup-plan entry JSON object (stdout).
# Args: <path> <plan_kind: report|archive|delete>
# Uses inventory manifest_count + newest_file_age_days as authority.
_classify_entry_json() {
  local path="$1" plan_kind="$2"
  local mf retention approved mc newest disposition reason approved_match="null" threshold

  if _is_blocked_path "$path"; then
    jq -nc --arg path "$path" \
      '{path:$path,disposition:"blocked",reason:"lib-or-src",retention:null,approved_to_matches:null}'
    return 0
  fi

  mc="$(jq -r --arg p "$path" \
    '.workflows[] | select(.path == $p) | .manifest_count' "$INV")"
  newest="$(jq -r --arg p "$path" \
    '.workflows[] | select(.path == $p) | .newest_file_age_days // empty' "$INV")"
  [ -n "$mc" ] || mc=0

  retention=""
  approved=""
  mf=""
  if [ "$mc" = "1" ]; then
    mf="$(_find_single_manifest "$path" || true)"
    if [ -n "$mf" ] && [ -f "$mf" ]; then
      if ! jq -e . "$mf" >/dev/null 2>&1; then
        jq -nc --arg path "$path" \
          '{path:$path,disposition:"blocked",reason:"invalid-manifest",retention:null,approved_to_matches:null}'
        return 0
      fi
      retention="$(jq -r '.retention // empty' "$mf")"
      approved="$(jq -r '.approved_to // empty' "$mf")"
    else
      # Inventory claimed one manifest but filesystem disagrees → invalid.
      jq -nc --arg path "$path" \
        '{path:$path,disposition:"blocked",reason:"invalid-manifest",retention:null,approved_to_matches:null}'
      return 0
    fi
  fi

  if [ "$mc" -gt 1 ] 2>/dev/null; then
    jq -nc --arg path "$path" \
      '{path:$path,disposition:"blocked",reason:"multiple-manifests",retention:null,approved_to_matches:null}'
    return 0
  fi

  if [ "$plan_kind" = "report" ]; then
    if [ "$mc" -eq 0 ]; then
      disposition="advisory"; reason="no-manifest"
    elif [ "$retention" = "permanent" ]; then
      disposition="blocked"; reason="retention-permanent"
    else
      threshold="$(_auto_archive_days "$retention")"
      if [ -n "$threshold" ] && [ -n "$newest" ] && [ "$newest" -ge "$threshold" ] 2>/dev/null; then
        disposition="advisory"; reason="stale"
      elif [ "$retention" = "review-before-delete" ] || [ "$retention" = "session-exports" ]; then
        disposition="advisory"; reason="retention-review-required"
      elif [ -n "$threshold" ]; then
        disposition="advisory"; reason="current"
      else
        disposition="advisory"; reason="current"
      fi
    fi
  elif [ "$plan_kind" = "archive" ]; then
    if [ "$mc" -eq 0 ]; then
      disposition="blocked"; reason="no-manifest"
    elif [ "$retention" = "permanent" ]; then
      disposition="blocked"; reason="retention-permanent"
    else
      threshold="$(_auto_archive_days "$retention")"
      if [ -n "$threshold" ] && [ -n "$newest" ] && [ "$newest" -ge "$threshold" ] 2>/dev/null; then
        disposition="would_archive"; reason="stale"
      elif [ "$retention" = "review-before-delete" ] || [ "$retention" = "session-exports" ]; then
        disposition="advisory"; reason="retention-review-required"
      elif [ -n "$threshold" ]; then
        disposition="advisory"; reason="current"
      else
        disposition="advisory"; reason="current"
      fi
    fi
  else
    # delete
    if [ -z "$SCOPE" ]; then
      disposition="blocked"; reason="scope-required"
    else
      case "$path" in
        "$SCOPE"|"$SCOPE"/*) ;;
        *)
          disposition="blocked"; reason="outside-scope"
          jq -nc --arg path "$path" --arg reason "$reason" --arg retention "$retention" \
            --argjson am null \
            '{path:$path,disposition:"blocked",reason:$reason,
              retention:(if $retention=="" then null else $retention end),
              approved_to_matches:$am}'
          return 0
          ;;
      esac
      if [ "$mc" -eq 0 ]; then
        disposition="blocked"; reason="no-manifest"
      elif [ "$retention" = "permanent" ]; then
        disposition="blocked"; reason="retention-permanent"
      elif [ -z "$approved" ]; then
        disposition="blocked"; reason="approved-to-null"
        approved_match="false"
      elif [ "$approved" != "$SCOPE" ]; then
        disposition="blocked"; reason="approved-to-mismatch"
        approved_match="false"
      else
        disposition="would_delete"; reason="approved"
        approved_match="true"
      fi
    fi
  fi

  local ret_json="null" am_json="null"
  [ -n "$retention" ] && ret_json="$(jq -nc --arg r "$retention" '$r')"
  if [ "$approved_match" = "true" ]; then am_json=true
  elif [ "$approved_match" = "false" ]; then am_json=false
  fi

  jq -nc --arg path "$path" --arg disp "$disposition" --arg reason "$reason" \
    --argjson retention "$ret_json" --argjson am "$am_json" \
    '{path:$path,disposition:$disp,reason:$reason,retention:$retention,approved_to_matches:$am}'
}

# Build full cleanup-plan JSON for report-only or dry-run.
# Args: <plan_kind: report|archive>
_emit_cleanup_plan_json() {
  local plan_kind="$1"
  local entries='[]' path entry
  local inv_gen
  inv_gen="$(jq -r '.generated_at' "$INV")"

  while IFS= read -r path; do
    [ -n "$path" ] || continue
    if [ -n "$SCOPE" ]; then
      case "$path" in
        "$SCOPE"|"$SCOPE"/*) ;;
        *) continue ;;
      esac
    fi
    entry="$(_classify_entry_json "$path" "$plan_kind")"
    # dry-run with scope: delete classification is authoritative for in-scope paths
    if [ "$plan_kind" = "archive" ] && [ -n "$SCOPE" ]; then
      entry="$(_classify_entry_json "$path" "delete")"
    fi
    entries="$(jq -c --argjson e "$entry" '. + [$e]' <<<"$entries")"
  done < <(jq -r '.workflows[].path' "$INV")

  entries="$(jq -c 'sort_by(.path)' <<<"$entries")"
  local scope_json="null"
  [ -n "$SCOPE" ] && scope_json="$(jq -nc --arg s "$SCOPE" '$s')"

  jq -n \
    --arg ts "$(_ontarch_now)" \
    --arg mode "$MODE" \
    --argjson scope "$scope_json" \
    --arg inv_gen "$inv_gen" \
    --argjson refreshed "$INVENTORY_REFRESHED" \
    --argjson entries "$entries" '
    ($entries) as $e |
    {
      generated_at: $ts,
      mode: $mode,
      scope: $scope,
      inventory_generated_at: $inv_gen,
      inventory_refreshed: $refreshed,
      summary: {
        total: ($e | length),
        advisory: ([ $e[] | select(.disposition == "advisory") ] | length),
        would_archive: ([ $e[] | select(.disposition == "would_archive") ] | length),
        would_delete: ([ $e[] | select(.disposition == "would_delete") ] | length),
        blocked: ([ $e[] | select(.disposition == "blocked") ] | length)
      },
      entries: $e,
      mutation_executed: false
    }'
}

_emit_plan_lines() {
  local plan_kind="$1"
  local path entry disp reason retention
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    if [ -n "$SCOPE" ] && [ "$plan_kind" != "delete" ]; then
      case "$path" in
        "$SCOPE"|"$SCOPE"/*) ;;
        *) continue ;;
      esac
    fi
    entry="$(_classify_entry_json "$path" "$plan_kind")"
    disp="$(jq -r '.disposition' <<<"$entry")"
    reason="$(jq -r '.reason' <<<"$entry")"
    retention="$(jq -r '.retention // empty' <<<"$entry")"
    case "$disp" in
      blocked) printf 'BLOCKED  %s  reason=%s\n' "$path" "$reason" ;;
      would_archive)
        printf 'WOULD_ARCHIVE %s  retention=%s archive_reason=%s promoted_to=%s/archives/\n' \
          "$path" "$retention" "$reason" "$(dirname "$path")"
        ;;
      would_delete)
        printf 'WOULD_DELETE  %s  retention=%s reason=%s\n' "$path" "$retention" "$reason"
        ;;
      advisory)
        printf 'ADVISORY %s  reason=%s retention=%s\n' "$path" "$reason" "${retention:--}"
        ;;
    esac
  done < <(jq -r '.workflows[].path' "$INV")
}

_report_only() {
  if [ "$JSON_MODE" -eq 1 ]; then
    local plan tmp
    tmp="$(ontarch_mktemp_registry bin-plan)" || exit 1
    _emit_cleanup_plan_json report > "$tmp"
    if ! ontarch_validate_bin_cleanup_plan_doc "$tmp"; then
      rm -f "$tmp"
      ontarch_err "cleanup plan validation failed"
      exit 1
    fi
    cat "$tmp"
    printf '\n'
    rm -f "$tmp"
    return 0
  fi
  ontarch_info "ontarch bin-cleanup — report-only (no action)"
  _print_inventory_summary
  printf 'stale / review candidates:\n'
  local path entry reason
  while IFS= read -r path; do
    entry="$(_classify_entry_json "$path" "report")"
    reason="$(jq -r '.reason' <<<"$entry")"
    case "$reason" in
      stale|no-manifest|retention-review-required|multiple-manifests)
        printf '  - %s  (reason=%s)\n' "$path" "$reason"
        ;;
    esac
  done < <(jq -r '.workflows[].path' "$INV")
  printf '\nblocked by policy (all modes): rm -rf globs, git clean, lib/src, retention=permanent, unmanifested deletes, multiple manifests\n'
  ontarch_ok "report-only complete (no filesystem changes)"
}

_dry_run() {
  if [ "$JSON_MODE" -eq 1 ]; then
    local tmp
    tmp="$(ontarch_mktemp_registry bin-plan)" || exit 1
    _emit_cleanup_plan_json archive > "$tmp"
    if ! ontarch_validate_bin_cleanup_plan_doc "$tmp"; then
      rm -f "$tmp"
      ontarch_err "cleanup plan validation failed"
      exit 1
    fi
    cat "$tmp"
    printf '\n'
    rm -f "$tmp"
    return 0
  fi
  ontarch_info "ontarch bin-cleanup — dry-run (exact plan; no action)"
  _print_inventory_summary
  printf 'plan (archive candidates):\n'
  _emit_plan_lines archive
  printf '\nplan (delete-approved candidates; require matching --scope + approved_to):\n'
  if [ -n "$SCOPE" ]; then
    printf 'scope: %s\n' "$SCOPE"
  else
    printf 'scope: (none — delete lines will show scope-required / mismatch)\n'
  fi
  _emit_plan_lines delete
  printf '\nNOTE: draft gateway — dry-run never executes rm/mv.\n'
  ontarch_ok "dry-run complete (no filesystem changes)"
}

_refuse_mutation() {
  local mode="$1"
  if [ "${PANOPLY_AGENT:-}" = "1" ]; then
    if [ "$JSON_MODE" -eq 1 ]; then
      _emit_refusal_json "$mode" "agent_rail"
    else
      ontarch_err "mode=$mode refused under PANOPLY_AGENT=1 (agent rail)"
    fi
    exit 1
  fi
  # Scope already validated in preflight for delete-approved.
  if [ "$JSON_MODE" -eq 1 ]; then
    _emit_refusal_json "$mode" "draft_gateway_deferred"
    exit 1
  fi
  ontarch_info "ontarch bin-cleanup — mode=$mode (draft gateway)"
  _print_inventory_summary
  if [ "$mode" = "delete-approved" ]; then
    printf 'validated scope: %s\n' "$SCOPE"
    printf 'would-be plan:\n'
    _emit_plan_lines delete
  else
    printf 'would-be plan:\n'
    _emit_plan_lines archive
  fi
  ontarch_err "mode=$mode deferred at draft gateway — no archive/delete executed (see docs/bin-archive.md)"
  exit 1
}

case "$MODE" in
  report-only) _report_only ;;
  dry-run) _dry_run ;;
  archive) _refuse_mutation archive ;;
  delete-approved) _refuse_mutation delete-approved ;;
esac
