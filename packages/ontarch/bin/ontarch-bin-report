#!/usr/bin/env bash
# ontarch-bin-report — read-only inventory of Workstreams/*/bin/<workflow>/ directories.
# Writes registry/bin-inventory.json (machine) and registry/BIN-INVENTORY.md (human table).
# --json: exactly one validated inventory document on stdout; progress on stderr.
# Agent-safe: no writes under bin/.
set -uo pipefail

_self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$_self/../lib/common.sh"
# shellcheck source=../lib/registry.sh
source "$_self/../lib/registry.sh"

ontarch_require_jq
mkdir -p "$ONTARCH_REGISTRY"

JSON_MODE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --json) JSON_MODE=1; shift ;;
    -h|--help)
      cat <<EOF
ontarch bin-report — read-only bin inventory

usage: ontarch bin-report [--json]

  --json   emit exactly one validated inventory JSON document on stdout
EOF
      exit 0
      ;;
    *) ontarch_err "unknown argument: $1"; exit 1 ;;
  esac
done

if [ "$JSON_MODE" -eq 1 ]; then
  ontarch_info() { printf '%s\n' "${_C_BLUE}::${_C_RESET} $*" >&2; }
  ontarch_ok()   { printf '%s\n' "${_C_GREEN}ok${_C_RESET} $*" >&2; }
fi

ontarch_info "ontarch bin-report — read-only inventory ($WS_ROOT/*/bin)"

json_tmp="$(ontarch_mktemp_registry bin-inv)" || exit 1
md_tmp="$(ontarch_mktemp_registry bin-md)" || { rm -f "$json_tmp"; exit 1; }

cleanup_generated_temps() {
  rm -f "$json_tmp" "$md_tmp"
}
trap cleanup_generated_temps EXIT HUP INT TERM

if ! ontarch_emit_bin_inventory >"$json_tmp"; then
  ontarch_err "bin inventory generation failed"
  exit 1
fi

if ! ontarch_validate_bin_inventory_doc "$json_tmp" "$WS_ROOT"; then
  ontarch_err "bin inventory validation failed — previous inventory retained if present"
  exit 1
fi

if ! ontarch_render_bin_inventory_markdown "$json_tmp" >"$md_tmp"; then
  ontarch_err "inventory markdown render failed"
  exit 1
fi

if ! ontarch_install_generated_pair \
  "$json_tmp" "$ONTARCH_REGISTRY/bin-inventory.json" \
  "$md_tmp" "$ONTARCH_REGISTRY/BIN-INVENTORY.md"; then
  ontarch_err "inventory install failed — previous outputs retained if present"
  exit 1
fi

# Installed; clear trap (temps already moved away).
json_tmp=""
md_tmp=""
trap - EXIT HUP INT TERM

n=$(jq -r '.summary.total' "$ONTARCH_REGISTRY/bin-inventory.json")
m=$(jq -r '.summary.with_manifest' "$ONTARCH_REGISTRY/bin-inventory.json")
ontarch_ok "bin-inventory.json ($n workflow dirs: $m with manifest)"
ontarch_ok "BIN-INVENTORY.md  -> registry/BIN-INVENTORY.md"

if [ "$JSON_MODE" -eq 1 ]; then
  cat "$ONTARCH_REGISTRY/bin-inventory.json"
  printf '\n'
fi
