#!/usr/bin/env bash
# ontarch agents-init — materialize the agents navigation pattern into $AGENTS_HOME.
# Seeds contracts, templates, and example records from packages/ontarch/patterns/agents/.
# Refuses to overwrite existing files unless --force. Never writes local-toolkit.yml
# (that file is generated by ontarch sync).
set -uo pipefail

_self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$_self/../lib/common.sh"

FORCE=0
TARGET=""
SELF_CHECK=0

usage() {
  cat <<EOF
ontarch agents-init — seed a working .agents/ from the Ontarch agents pattern

usage: ontarch agents-init [--force] [--target DIR]
       ontarch agents-init --self-check

  --force         overwrite existing files when copying the seed
  --target DIR    materialize into DIR (default: \$AGENTS_HOME)
  --self-check    run a temp-dir seed assert and exit (no workspace writes)

Environment:
  AGENTS_HOME     working navigation layer (overrides discovery)
  WS_ROOT         workspace root; AGENTS_HOME becomes \$WS_ROOT/.agents

The pattern seed lives at:
  $ONTARCH_AGENTS_PATTERN
EOF
}

# Copy $1 → $2. Skip when dest exists unless --force. Returns 0 if written/skipped ok.
_agents_copy() {
  local src="$1" dest="$2"
  if [ -e "$dest" ] && [ "$FORCE" -eq 0 ]; then
    ontarch_info "skip (exists) $dest"
    return 0
  fi
  mkdir -p "$(dirname "$dest")"
  cp "$src" "$dest"
  ontarch_ok "wrote $dest"
}

# Materialize example TOMLs: patterns/.../examples/foo.toml → $target/foo.toml
_agents_copy_examples() {
  local src_dir="$1" dest_dir="$2" f base
  [ -d "$src_dir" ] || return 0
  mkdir -p "$dest_dir"
  for f in "$src_dir"/*.toml; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    _agents_copy "$f" "$dest_dir/$base"
  done
}

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) FORCE=1; shift ;;
      --self-check) SELF_CHECK=1; shift ;;
      --target)
        [ $# -ge 2 ] || ontarch_die "--target requires a directory"
        TARGET="$2"
        shift 2
        ;;
      -h|--help|help) usage; exit 0 ;;
      *) ontarch_die "unknown argument: $1 (see --help)" ;;
    esac
  done

  if [ "$SELF_CHECK" -eq 1 ]; then
    # ponytail: temp-dir assert — fails if seed copy or .pattern-lock breaks.
    local tmp
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/ontarch-agents-init.XXXXXX")"
    trap 'rm -rf "$tmp"' EXIT
    TARGET="$tmp/agents"
    FORCE=0
    ontarch_info "self-check: seeding $TARGET"
  fi

  local pattern="$ONTARCH_AGENTS_PATTERN"
  [ -d "$pattern" ] || ontarch_die "agents pattern missing: $pattern"
  [ -f "$pattern/PATTERN.toml" ] || ontarch_die "PATTERN.toml missing: $pattern/PATTERN.toml"

  local dest="${TARGET:-$AGENTS_HOME}"
  case "$dest" in
    /*) ;;
    *) dest="$(cd "$dest" 2>/dev/null && pwd)" || ontarch_die "cannot resolve --target: ${TARGET:-$AGENTS_HOME}" ;;
  esac
  [ "$dest" != "/" ] && [ -n "$dest" ] || ontarch_die "refusing to materialize into filesystem root"

  local pid pver
  pid="$(ontarch_pattern_field "$pattern/PATTERN.toml" id)"
  pver="$(ontarch_pattern_field "$pattern/PATTERN.toml" version)"
  [ -n "$pid" ] && [ -n "$pver" ] || ontarch_die "PATTERN.toml missing id or version"

  ontarch_info "ontarch agents-init — seeding $dest from $pattern (pattern $pid@$pver)"

  mkdir -p "$dest"/{profiles,skills,tools,graphs}

  # Seed-owned templates (AGENTS.template.md, skills/templates/*) stay in the pattern;
  # resolve/validate fall back to ONTARCH_AGENTS_PATTERN. Working copy gets contracts +
  # example records only.
  _agents_copy "$pattern/README.md" "$dest/README.md"
  _agents_copy "$pattern/profiles/README.md" "$dest/profiles/README.md"
  _agents_copy "$pattern/skills/README.md" "$dest/skills/README.md"
  _agents_copy "$pattern/tools/README.md" "$dest/tools/README.md"
  _agents_copy "$pattern/graphs/README.md" "$dest/graphs/README.md"

  if [ -f "$pattern/.gitignore.seed" ]; then
    _agents_copy "$pattern/.gitignore.seed" "$dest/.gitignore"
  fi

  _agents_copy_examples "$pattern/profiles/examples" "$dest/profiles"
  _agents_copy_examples "$pattern/skills/examples" "$dest/skills"

  # Always refresh the lock so the working copy records the seed it was last aligned to.
  cat > "$dest/.pattern-lock" <<EOF
# Generated by ontarch agents-init — do not hand-edit the id/version pair.
# Working profiles/skills may diverge; re-run with --force to reset from the seed.
# Seed-owned templates live under packages/ontarch/patterns/agents/ (not copied here).
pattern_id = "$pid"
pattern_version = "$pver"
seeded_at = "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
seed_path = "packages/ontarch/patterns/agents"
EOF
  ontarch_ok "wrote $dest/.pattern-lock ($pid@$pver)"

  if [ "$SELF_CHECK" -eq 1 ]; then
    [ -f "$dest/.pattern-lock" ] || ontarch_die "self-check: missing .pattern-lock"
    [ -f "$dest/profiles/docs-only.toml" ] || ontarch_die "self-check: missing docs-only.toml"
    [ ! -e "$dest/profiles/AGENTS.template.md" ] || ontarch_die "self-check: AGENTS.template.md should stay in pattern"
    [ ! -e "$dest/skills/templates" ] || ontarch_die "self-check: skills/templates should stay in pattern"
    [ -f "$pattern/skills/templates/adr.md" ] || ontarch_die "self-check: pattern missing adr.md"
    # Fallback must find the pattern body when AGENTS_HOME has no local templates/.
    AGENTS_HOME="$dest"
    path="$(ontarch_template_body_path "templates/adr.md")" \
      || ontarch_die "self-check: template body fallback failed"
    [ "$path" = "$pattern/skills/templates/adr.md" ] \
      || ontarch_die "self-check: unexpected body path: $path"
    grep -q "pattern_id = \"$pid\"" "$dest/.pattern-lock" || ontarch_die "self-check: bad pattern_id"
    FORCE=0
    _agents_copy "$pattern/README.md" "$dest/README.md"
    ontarch_ok "self-check passed"
    exit 0
  fi

  ontarch_ok "agents navigation layer ready at $dest"
  ontarch_info "next: customize profiles/*.toml paths, then moon run ontarch:validate"
}

main "$@"
